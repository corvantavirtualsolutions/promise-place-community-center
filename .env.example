# Copy to .env.local for local development. In production these live in
# Vercel → Project → Settings → Environment Variables.
#
# None of these are NEXT_PUBLIC_*, so none of them reach the browser.

# ---- Supabase → Project Settings → API ----
SUPABASE_URL=https://your-project-ref.supabase.co

# The SERVICE ROLE key. It bypasses row-level security, which is how the site
# reads and writes a table that is otherwise closed to everyone. Never put this
# in client code or in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# The ANON key. Used only for sign-in (/auth/v1/*). Safe by design, but there
# is no reason to expose it, so it stays server-side too.
SUPABASE_ANON_KEY=

# ---- Staff dashboard at /admin ----
# The ONLY address allowed to sign in. Checked on sign-in and again on every
# page load, so adding another user in Supabase does not grant access.
ADMIN_EMAIL=admin@promiseplacecc.com

# ---- Mailgun (contact form emails) ----
# Optional. Without these the form still saves and the dashboard still works;
# no email is attempted. Mailgun → Send → Domain settings → Sending API keys.
MAILGUN_API_KEY=

# Use a SUBDOMAIN, not the root domain. Mailgun asks you to add MX records, and
# putting those on promiseplacecc.com would take over mail for
# admin@promiseplacecc.com. A subdomain keeps the real inbox untouched.
MAILGUN_DOMAIN=mg.promiseplacecc.com

# https://api.mailgun.net for a US account, https://api.eu.mailgun.net for EU.
# A key issued in one region will NOT authenticate against the other.
MAILGUN_BASE_URL=https://api.mailgun.net

# Must be on MAILGUN_DOMAIN. The display name is what recipients see.
MAILGUN_FROM=Promise Place Community Center <no-reply@mg.promiseplacecc.com>

# Where staff notifications go, and where replies to the auto-reply land.
CONTACT_TO_EMAIL=admin@promiseplacecc.com

# ---- Contact form ----
# Any long random string. Salts the IP hash used for rate limiting so the
# stored hashes can't be brute-forced back into addresses.
IP_HASH_SALT=
